#!/usr/bin/env bash
# Launcher of the Movie Codec Converter.
# It can be started from anywhere and it also works through a symbolic link.

set -euo pipefail

resolve_project_directory() {
    local script_path="${BASH_SOURCE[0]}"
    while [ -L "$script_path" ]; do
        local link_target
        link_target="$(readlink "$script_path")"
        case "$link_target" in
            /*) script_path="$link_target" ;;
            *) script_path="$(dirname "$script_path")/$link_target" ;;
        esac
    done
    cd -- "$(dirname -- "$script_path")" && pwd
}

require_python() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "python3 was not found on this system." >&2
        echo "Install it first, for example: sudo dnf install python3" >&2
        exit 1
    fi
}

main() {
    require_python
    local project_directory
    project_directory="$(resolve_project_directory)"
    PYTHONPATH="$project_directory${PYTHONPATH:+:$PYTHONPATH}" exec python3 -m movie_codec_converter "$@"
}

main "$@"
